{
  "name": "oneagent",
  "version": "1.0.0",
  "description": "Welcome to the Standalone AI Browser Agent project! This is a cross-platform (MacOS, Windows, Linux) desktop application built with Electron. It functions as an autonomous AI agent equipped with a deeply integrated, embedded web browser.",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && tsc -p tsconfig.electron.json && electron dist-electron/main.js"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@nut-tree-fork/nut-js": "^4.2.6",
    "@uiw/react-codemirror": "^4.25.11",
    "@xenova/transformers": "^2.17.2",
    "adm-zip": "^0.6.0",
    "clsx": "^2.1.1",
    "electron-chrome-extensions": "^4.9.0",
    "katex": "^0.18.4",
    "lucide-react": "^1.32.0",
    "mammoth": "^1.12.1",
    "officeparser": "^7.8.0",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-mentions": "^4.4.10",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-mentions": "^4.4.1",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "wait-on": "^9.1.0"
  }
}
